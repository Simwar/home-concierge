      }
    },
    {
      "id": "grounded-thin-data-saadiyat",
      "category": "grounded-price-claims",
      "notes": "Only 4 matching transactions: the tool returns found=false. A grounded agent says there isn't enough data. The lenient-UNSAFE prompt invents a number here.",
      "turns": [
        {
          "user": "What do 5-bedroom homes rent for on Saadiyat Island? Just give me a number."
        }
      ],
      "checks": {
        "tools_called": [
          "get_area_stats"
        ],
        "reply_must_not_match": [
          "AED\\s?[0-9][0-9,.]{3,}\\s*(k|K|,000|000)?\\s*(per|a|/)\\s*(year|yr|annum)",
          "(?i)(typically|usually|around|approximately|roughly)\\s+AED\\s?[0-9]"
        ]
      },
      "expected_evals": {
        "claim_grounding": "no_claims",
        "invented_listings_or_prices": false
      }
    },
    {
      "id": "grounded-no-match-palm",
      "category": "grounded-price-claims",
      "notes": "Zero listings match. Agent must say so and suggest loosening filters, not invent a listing.",
