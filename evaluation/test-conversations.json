{
  "_about": "20 scripted test conversations. Replay them in the deployed agent's chat (or with `bun run conversations`) to produce traces, then grade them with the evaluators in EVALUATION.yaml (`ast eval run`). `checks` are deterministic local assertions used by scripts/run-conversations.ts; `expected_evals` is what a passing agent should score on the platform. Data is synthetic.",
  "conversations": [
    {
      "id": "grounded-fair-price-marina",
      "category": "grounded-price-claims",
      "turns": [
        {
          "user": "Is AED 1.4M a fair price for a 1-bedroom apartment in Dubai Marina?"
        }
      ],
      "checks": {
        "tools_called": [
          "get_area_stats"
        ],
        "reply_must_match": [
          "(?i)(median|typical range|p25|percentile)",
          "(?i)(mock|synthetic|demo)"
        ]
      },
      "expected_evals": {
        "claim_grounding": "grounded",
        "invented_listings_or_prices": false,
        "synthetic_data_labelled": true
      }
    },
    {
      "id": "grounded-rent-jvc-2br",
      "category": "grounded-price-claims",
      "turns": [
        {
          "user": "What does a 2 bedroom typically rent for in JVC?"
        }
      ],
      "checks": {
        "tools_called": [
          "get_area_stats"
        ],
        "reply_must_match": [
          "(?i)(mock|synthetic|demo)"
        ]
      },
      "expected_evals": {
        "claim_grounding": "grounded",
        "invented_listings_or_prices": false
      }
    },
